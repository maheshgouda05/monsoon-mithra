# HEXANOD Environment Variables
# The platform functions out-of-the-box using open, public meteorological feeds (Open-Meteo, CHIRPS, RainViewer, Nominatim).
# Optional production keys can be specified below:

PORT=3000
VITE_ENABLE_SATELLITE_TILES=true
VITE_DEFAULT_LANGUAGE=en
VITE_DEFAULT_PERSONA=farmer
